# Copy to the repository root as .env (ignored by git) and fill in local values.
DETECDIV_HUB_ENVIRONMENT=prod
DETECDIV_HUB_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@DB_HOST:5432/detecdiv_hub
DETECDIV_HUB_WORKER_TARGET_KEY=windows-worker-example
DETECDIV_HUB_WORKER_INSTANCE=windows-worker-example-main
DETECDIV_HUB_WORKER_CLAIM_UNASSIGNED_JOBS=true
DETECDIV_HUB_WORKER_JOB_KINDS=
DETECDIV_HUB_WORKER_EXCLUDED_JOB_KINDS=archive_raw_dataset,restore_raw_dataset,pipeline_run,legacy_matlab
DETECDIV_HUB_WORKER_ENABLE_SCHEDULERS=false
DETECDIV_HUB_WORKER_POLL_INTERVAL_SEC=5
DETECDIV_HUB_MATLAB_COMMAND=C:\Program Files\MATLAB\R20XXx\bin\matlab.exe
DETECDIV_HUB_MATLAB_REPO_ROOT=C:\DetecDiv
# Map canonical server paths and legacy MATLAB paths to the same SMB share.
# Use forward slashes in JSON targets; JSON-escape the X: source backslash.
DETECDIV_HUB_WORKER_PATH_MAPPINGS=[{"source":"/data","target":"//FILESERVER/SHARE"},{"source":"X:\\","target":"//FILESERVER/SHARE"}]

# Copy this file to /etc/detecdiv-hub/qwen.env on detecdiv-server.
# Use a locally compatible, quantized Qwen model. The vLLM port is reachable
# only from webserver-labo through a host firewall; never expose it to clients.
DETECDIV_QWEN_VLLM_BIN=/home/charvin-admin/venvs/detecdiv-qwen/bin/vllm
DETECDIV_QWEN_MODEL=CHANGE_ME_TO_A_QUANTIZED_QWEN_MODEL
DETECDIV_QWEN_HOST=0.0.0.0
DETECDIV_QWEN_PORT=8001
DETECDIV_QWEN_MAX_MODEL_LEN=8192
DETECDIV_QWEN_GPU_MEMORY_UTILIZATION=0.80
DETECDIV_QWEN_MAX_NUM_SEQS=1

# The /data CIFS mount does not support Hugging Face's required symlinks.
# Keep the Qwen model cache on a local Linux filesystem instead.
HF_HOME=/home/charvin-admin/.cache/detecdiv-qwen/huggingface
HF_HUB_CACHE=/home/charvin-admin/.cache/detecdiv-qwen/huggingface/hub
TRANSFORMERS_CACHE=/home/charvin-admin/.cache/detecdiv-qwen/huggingface/hub

# Required on this host's CUDA 12.0 toolkit; vLLM uses its compatible sampler.
VLLM_USE_FLASHINFER_SAMPLER=0
